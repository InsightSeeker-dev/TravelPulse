<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TripDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/toolbar_bg"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_trip_detail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="Détails du Voyage"
            app:titleTextColor="@android:color/white"/>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:id="@+id/text_view_trip_detail_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:textStyle="bold"
            android:paddingBottom="24dp"
            tools:text="Nom du Voyage Exemple" />

        <!-- Bouton principal rempli -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_toggle_tracking"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_marginTop="8dp"
            android:text="Démarrer Enregistrement Tracé"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/white"
            android:icon="@drawable/ic_play_arrow"
            android:iconTint="@android:color/white"
            app:iconPadding="12dp"
            app:cornerRadius="28dp"
            android:elevation="2dp"/>

        <!-- Boutons outlined -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_edit_trip"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginTop="14dp"
            android:text="Modifier ce voyage"
            android:textColor="#2196F3"
            android:icon="@drawable/ic_edit"
            android:iconTint="#2196F3"
            app:iconPadding="12dp"
            app:strokeColor="#2196F3"
            app:strokeWidth="2dp"
            app:cornerRadius="28dp"
            android:elevation="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_show_map"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginTop="14dp"
            android:text="Afficher sur carte"
            android:textColor="#2196F3"
            android:icon="@drawable/ic_map"
            android:iconTint="#2196F3"
            app:iconPadding="12dp"
            app:strokeColor="#2196F3"
            app:strokeWidth="2dp"
            app:cornerRadius="28dp"
            android:elevation="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_export_gpx"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginTop="14dp"
            android:text="Exporter GPX/KML"
            android:textColor="#2196F3"
            android:icon="@drawable/ic_save_alt"
            android:iconTint="#2196F3"
            app:iconPadding="12dp"
            app:strokeColor="#2196F3"
            app:strokeWidth="2dp"
            app:cornerRadius="28dp"
            android:elevation="0dp"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
